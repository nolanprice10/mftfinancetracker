{
  "id": "mftfinancetracker",
  "name": "MyFinanceTracker",
  "short_name": "MyFinanceTracker",
  "description": "Explore how capital is allocated under uncertainty and how quantitative models inform real market decisions. A quant-driven finance toolkit with practical insights.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "categories": ["finance", "productivity", "education"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/dashboard-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Desktop dashboard overview"
    },
    {
      "src": "screenshots/dashboard-narrow.png",
      "sizes": "720x1280",
      "type": "image/png",
      "label": "Mobile dashboard overview"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Open your finance dashboard",
      "url": "./dashboard",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Transactions",
      "short_name": "Transactions",
      "description": "Review transactions quickly",
      "url": "./transactions",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Quant Lab",
      "short_name": "Quant Lab",
      "description": "Open quantitative models",
      "url": "./quant-lab",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+mft",
      "url": "./?open=%s"
    }
  ]
}
